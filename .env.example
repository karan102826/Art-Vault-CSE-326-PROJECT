# ============================================================================
# ArtVault Marketplace - Environment Configuration
# ============================================================================

# Application Environment: 'development' or 'production'
NODE_ENV="production"

# Port (Render and local server listen on this port, defaults to 3000 or 10000)
PORT=3000

# JSON Web Token Secret used for signing authentication sessions
JWT_SECRET="replace_with_a_secure_random_64_char_secret_key"

# PostgreSQL / Supabase Database Connection String
# e.g., postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or on Render: automatic via Render Blueprint database
DATABASE_URL="postgresql://user:password@localhost:5432/artvault"

# CORS Allowed Client Origin (for split frontend on Vercel & backend on Render)
CLIENT_URL="https://my-artvault.vercel.app"

# Frontend API Target (set on Vercel if backend is hosted separately on Render)
# e.g., https://artvault-marketplace.onrender.com
VITE_API_URL=""

# Optional Supabase SDK keys (Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# AI Studio runtime keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
